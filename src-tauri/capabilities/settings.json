{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "What the settings window may call",
  "windows": ["settings"],
  "permissions": [
    "core:event:default",
    "allow-get-state",
    "allow-set-config",
    "allow-check-update",
    "allow-install-update",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-identify",
    "allow-test-white",
    "allow-reconnect",
    "allow-layout-preview",
    "allow-list-displays",
    "allow-list-ports",
    "allow-running-apps",
    "allow-streaming-services",
    "allow-open-permission-settings"
  ]
}
