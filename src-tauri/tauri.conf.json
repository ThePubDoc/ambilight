{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ambilight",
  "version": "0.2.3",
  "identifier": "com.thepubdoc.ambilight",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Screen-synced LED lighting for your monitor",
    "longDescription": "Ambilight mirrors the edges of your screen onto an Adalight-compatible LED strip behind your monitor.",
    "copyright": "© 2026 Aayush Agrawal. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.2",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0M0JDQzIwQzM4MDM1OEYKUldTUE5ZRERJTXc3WkpGbW91VjBZQTNGYkF6ZnQybmZoTU5rZUpDeXh4SHhrTFVjM3NMN3owaTAK",
      "endpoints": [
        "https://github.com/ThePubDoc/ambilight/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
